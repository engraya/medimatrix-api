{
  "name": "medimatrix-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --project integration tests/e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "tsx scripts/db/env.ts generate",
    "db:validate": "tsx scripts/db/env.ts validate",
    "db:migrate": "tsx scripts/db/env.ts migrate dev",
    "db:deploy": "tsx scripts/db/env.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "tsx scripts/db/env.ts studio",
    "db:reset": "tsx scripts/db/env.ts migrate reset",
    "db:psql": "tsx scripts/db/psql.ts",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:restore": "tsx scripts/db/restore.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "docs:api": "tsx scripts/generate-openapi.ts",
    "check:config": "tsx scripts/check-config-integrity.ts",
    "load:smoke": "autocannon -c 5 -a 100 http://localhost:4000/health/live"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.0.5",
    "@sentry/node": "^10.75.0",
    "argon2": "^0.41.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.1.1",
    "helmet": "^8.0.0",
    "jose": "^6.0.8",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.28.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.4.4",
    "ulid": "^2.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.22.0",
    "lefthook": "^1.11.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "hyperid": {
      "uuid": "^11.1.1"
    }
  }
}
